# Proveedor LLM — solo una de estas claves es necesaria
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Modelo a utilizar (por defecto: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Puerto del servidor (por defecto: 3000)
PORT=3000

# Tope de iteraciones por turno del agente
MAX_ITERATIONS=25

# Tope de tokens por sesión
MAX_TOKENS_PER_SESSION=100000
