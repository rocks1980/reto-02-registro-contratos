# Proveedor LLM — solo una de estas claves es necesaria
# Para Groq (por defecto):
OPENAI_API_KEY=tu-groq-api-key

# Para Gemini (alternativa):
# GEMINI_API_KEY=

# Modelo a utilizar
LLM_MODEL=openai/gpt-oss-120b

# Base URL del proveedor
LLM_BASE_URL=https://api.groq.com/openai/v1
# Para Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Para OpenAI: LLM_BASE_URL=https://api.openai.com/v1

# Puerto del servidor (por defecto: 3000)
PORT=3000

# Tope de iteraciones por turno del agente
MAX_ITERATIONS=25

# Tope de tokens por sesión
MAX_TOKENS_PER_SESSION=100000
