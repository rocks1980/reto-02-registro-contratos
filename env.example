# Proveedor LLM — solo una de estas claves es necesaria
# Para Gemini (por defecto):
GEMINI_API_KEY=

# Para OpenAI (alternativa):
# OPENAI_API_KEY=

# Modelo a utilizar (por defecto: gemini-2.0-flash)
LLM_MODEL=gemini-2.0-flash

# Base URL del proveedor (por defecto: Gemini OpenAI-compatible)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Para OpenAI: LLM_BASE_URL=https://api.openai.com/v1

# Puerto del servidor (por defecto: 3000)
PORT=3000

# Tope de iteraciones por turno del agente
MAX_ITERATIONS=25

# Tope de tokens por sesión
MAX_TOKENS_PER_SESSION=100000
